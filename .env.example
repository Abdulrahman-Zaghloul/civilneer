# Optional basic access protection for local/private testing.
# Leave blank for open local access.
CIVCHECK_BETA_USERNAME=
CIVCHECK_BETA_PASSWORD=

# Local runtime folders
CIVCHECK_EPHEMERAL_ROOT=/tmp/civcheck_ephemeral
CIVCHECK_RUN_TTL_SECONDS=1800
CIVCHECK_MAX_UPLOAD_BYTES=26214400
CIVCHECK_MAX_UPLOAD_PAGES=25

# Set to 1 to hide FastAPI docs in production-like runs.
CIVCHECK_DISABLE_DOCS=0

# Set to 1 only for local debugging.
CIVCHECK_INCLUDE_DEBUG_JSON=0
